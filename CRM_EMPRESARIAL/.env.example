# Copia este archivo como .env antes de iniciar Docker Compose.
# Usa una clave aleatoria larga (32 bytes o mas) fuera del desarrollo local.
JWT_SECRET=reemplaza-esta-clave-por-una-clave-segura-de-al-menos-32-bytes
CORS_ALLOWED_ORIGINS=http://localhost:8081

# SMTP es opcional mientras no se envien correos.
MAIL_USERNAME=
MAIL_PASSWORD=
